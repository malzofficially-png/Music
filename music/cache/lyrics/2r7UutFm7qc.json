{"status":true,"input":{"id":"2r7UutFm7qc"},"result":{"videoId":"2r7UutFm7qc","title":"Mati-Matian","artist":"Mahalini","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":19.35,"text":"Kita adalah dua insan penuh cinta"},{"time":28.51,"text":"Di awal tercipta kisah kita"},{"time":35.93,"text":"Manis tuturmu buatku terpana"},{"time":46.53,"text":"Bagiku kau sempurna"},{"time":52.75,"text":"Memang benar semua kata mereka"},{"time":62.53,"text":"Benar ku t'lah dibutakan cinta"},{"time":69.16,"text":"Tak hanya sekali kau khianati"},{"time":77.11,"text":"Sudah, cukup ku tak tahan lagi"},{"time":89.6,"text":"Mati-matian ku membelamu di depan mereka"},{"time":97.86,"text":"Walau sakit, tetap kupercaya kau beda dari lainnya"},{"time":106.38,"text":"Habis-habisan ku dibohongi, sayang ini tetap sama"},{"time":114.9,"text":"Tuhan, ini cinta atau bodoh?"},{"time":120.25,"text":"Habis pikir dengan sifatmu itu"},{"time":126.55,"text":"Berulang kali kumaafkan"},{"time":130.54,"text":"Berulang lagi kaulakukan"},{"time":136.94,"text":"Satu-satunya kebanggaanku"},{"time":143.54,"text":"Kini jadi rasa sakit terdalam"},{"time":151.79,"text":"Mati-matian ku membelamu di depan mereka"},{"time":158.95,"text":"Mati-matian ku membelamu di depan mereka"},{"time":167.92,"text":"Walau sakit, tetap kupercaya kau beda dari lainnya"},{"time":176.17,"text":"Habis-habisan ku dibohongi, sayang ini tetap sama"},{"time":184.93,"text":"Tuhan, ini cinta atau bodoh?"},{"time":190.23,"text":"(Mati-matian ku membelamu di depan mereka)"},{"time":195.25,"text":"Ho-oo, walau sakit, tetap kupercaya kau beda dari lainnya"},{"time":205.06,"text":"Habis-habisan ku dibohongi, sayang ini tetap sama"},{"time":214.07,"text":"Tuhan, ini cinta atau bodoh?"},{"time":221.29,"text":"Ho-oo, Tuhan, ini cinta atau bodoh?"},{"time":236.49,"text":"• • •"}]}}}