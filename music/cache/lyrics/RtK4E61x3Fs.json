{"status":true,"input":{"id":"RtK4E61x3Fs"},"result":{"videoId":"RtK4E61x3Fs","title":"Cincin","artist":"Hindia","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":27.02,"text":"Kau bermasalah jiwa, aku pun rada gila"},{"time":30.24,"text":"Jodoh akal-akalan neraka kita bersama"},{"time":33.38,"text":"Kau langganan menangis, lakimu muntah-muntah"},{"time":36.55,"text":"Begitu terus sampai iblis tobat dan sedekah"},{"time":39.63,"text":"Terkadang rasanya leher terbakar hingga pagi"},{"time":42.73,"text":"Seperti aku hidup berpasangan dengan api"},{"time":45.98,"text":"Berhenti, ulangi, psikolog, dan terapi"},{"time":49.25,"text":"Aku isi bensin, kita coba lagi"},{"time":52.65,"text":"Tapi s'belumnya"},{"time":55.67,"text":"Sejuta sayang untukmu, Cinta"},{"time":58.72,"text":"Kar'na aku pun bola panas juga"},{"time":61.81,"text":"Kadang lebih atau sama parahnya"},{"time":64.91,"text":"Dan jika bicara tentang masa depan"},{"time":68.04,"text":"Aku pun bingung, tak punya tebakan"},{"time":71.26,"text":"Lagu cinta untuk akhir dunia"},{"time":74.22,"text":"Lihat kami nyanyikan ini bersama"},{"time":77.33,"text":"S'moga hidup kita t'rus begini-gini saja"},{"time":84.83,"text":"Walau sungai meluap dan kurs tak masuk logika"},{"time":91.21,"text":"S'moga kita mencintai apa adanya"},{"time":97.27,"text":"Walau katanya s'karang ku bisa masuk penjara"},{"time":103.52,"text":"Satu per satu, hari per hari"},{"time":109.93,"text":"Yang menyakiti, benahi lagi"},{"time":116.03,"text":"Perihal esok, 'tuk nanti dulu"},{"time":122.28,"text":"Perihal cincin, kucari waktu"},{"time":128.65,"text":"Persetan kata siapa"},{"time":131.7,"text":"Mau bilang apa tak guna"},{"time":134.45,"text":"M'reka hanya tahu namamu"},{"time":137.59,"text":"M'reka takkan jadi diriku"},{"time":140.77,"text":"Persetan aturan cinta"},{"time":143.78,"text":"Tak tertulis di atas batu"},{"time":146.78,"text":"Apa kau ingin menjadi benar?"},{"time":149.4,"text":"Atau ingin menjadi muda?"},{"ti