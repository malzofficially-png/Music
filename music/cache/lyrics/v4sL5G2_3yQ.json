{"status":true,"input":{"id":"v4sL5G2_3yQ"},"result":{"videoId":"v4sL5G2_3yQ","title":"Sumbang","artist":"Iwan Fals","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":6.12,"text":"Kuatnya belenggu besi"},{"time":9.93,"text":"Mengikat kedua kaki"},{"time":14.14,"text":"Tajamnya ujung belati"},{"time":20.13,"text":"Menujam di ulu hati"},{"time":24.52,"text":"• • •"},{"time":27.49,"text":"Sanggupkah tak akan lari"},{"time":32.69,"text":"Walau akhirnya pasti mati?"},{"time":39.69,"text":"• • •"},{"time":45.89,"text":"Di kepala tanpa baja"},{"time":50.06,"text":"Di tangan tanpa senjata"},{"time":52.56,"text":"Ah, itu soal biasa"},{"time":55.43,"text":"Yang singgah di depan mata kita"},{"time":60.54,"text":"Lusuhnya kain bendera di halaman rumah kita"},{"time":67.74,"text":"Bukan satu alasan untuk kita tinggalkan"},{"time":72.52,"text":"Banyaknya persoalan yang datang tak kenal kasihan"},{"time":78.07,"text":"Menyerang dalam gelap"},{"time":82.08,"text":"Memburu kala haru dengan cara main kayu"},{"time":86.9,"text":"Tinggalkan bekas biru lalu pergi tanpa ragu"},{"time":92.54,"text":"Memburu kala haru dengan cara main kayu"},{"time":96.4,"text":"Tinggalkan bekas biru lalu pergi tanpa ragu"},{"time":103.94,"text":"• • •"},{"time":106.07,"text":"Setan-setan politik yang datang mencekik"},{"time":112.65,"text":"• • •"},{"time":121.26,"text":"Walau di masa paceklik tetap mencekik"},{"time":124.87,"text":"Apakah selamanya politik itu kejam?"},{"time":129.47,"text":"Apakah selamanya dia datang 'tuk menghantam?"},{"time":133.83,"text":"Ataukah memang itu yang sudah digariskan?"},{"time":139.61,"text":"Menjilat, menghasut, menindas"},{"time":144.93,"text":"Memperkosa hak-hak sewajarnya"},{"time":151.93,"text":"• • •"},{"time":157.91,"text":"Maling teriak maling, sembunyi balik dinding"},{"time":166.22,"text":"Pengecut lari terkencing-kencing"},{"time":172.83,"text":"Tikam dari belakang, lawan lengah diterjang"},{"time":177.34,"text":"Lalu sibuk mencari kambing hitam"},{"time":182.94,"text":"Selusin kepala tak berdosa"},{"time":188.21,"text":"Berteriak hingga serak"},{"time":191.66,"text":"Di dalam negeri yang congkak"},{"time":194.38,"text":"Lalu senang dalang tertawa"},{"time":198.36,"text":"\"Ya-ha-ha!\""},{"time":201.67,"text":"• • •"},{"time":215.39,"text":"Lusuhnya kain bendera di halaman rumah kita"},{"time":222.53,"text":"• • •"},{"time":235.07,"text":"Bukan satu alasan untuk kita tinggalkan"},{"time":239.55,"text":"Banyaknya persoalan yang datang tak kenal kasihan"},{"time":244.18,"text":"Menyerang dalam gelap"},{"time":249.34,"text":"Memburu kala haru dengan cara main kayu"},{"time":254.42,"text":"Tinggalkan bekas biru lalu pergi tanpa ragu"},{"time":258.72,"text":"Memburu kala haru dengan cara main kayu"},{"time":263.98,"text":"Tinggalkan bekas biru lalu pergi tanpa ragu"},{"time":271.17,"text":"Apakah selamanya politik itu kejam?"},{"time":278.64,"text":"Apakah selamanya dia datang 'tuk menghantam?"},{"time":283.66,"text":"Ataukah memang itu yang sudah digariskan?"},{"time":287.96,"text":"• • •"}]}}}