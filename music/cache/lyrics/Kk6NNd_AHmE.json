{"status":true,"input":{"id":"Kk6NNd_AHmE"},"result":{"videoId":"Kk6NNd_AHmE","title":"16 Juli 1996","artist":"Iwan Fals","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":25.59,"text":"Kukenal kamu dari jauh"},{"time":32.24,"text":"Tergetar hati melihatmu"},{"time":39.1,"text":"Matamu bening, suaramu bening"},{"time":43.27,"text":"Semangatmu hening"},{"time":46.48,"text":"Wajahmu lembut, senyummu lembut"},{"time":49.98,"text":"Rambutmu lepas tergerai"},{"time":55.5,"text":"Terasa sejuk mengenalmu"},{"time":61.73,"text":"Merdeka aku dibuaimu"},{"time":68.97,"text":"Jalan yang panjang sebatas pandang"},{"time":73.06,"text":"Kau tempuh tanpa mengeluh"},{"time":75.76,"text":"Tangan terkepal berangkatlah kapal"},{"time":79.51,"text":"Menuju dermaga sepi"},{"time":84.94,"text":"Kunyanyikan hanya untukmu"},{"time":91.52,"text":"Puja-puji ini karena rindu"},{"time":98.37,"text":"Air mata terlanjur tumpah"},{"time":105.31,"text":"Membasahi tanah menjadi darah"},{"time":111.95,"text":"Dipayungi mega kelabu"},{"time":118.16,"text":"• • •"},{"time":136.48,"text":"Aku tak peduli apa yang terjadi"},{"time":140.13,"text":"Jangan kau pergi dariku"},{"time":143.29,"text":"Akan kutemani ke dermaga sepi"},{"time":146.85,"text":"Membelai ombak yang biru"},{"time":150.56,"text":"Kau bangkitkan aku, kupanggil kau selalu"},{"time":153.81,"text":"Bertahanlah dalam gelombang"},{"time":157.58,"text":"Kau buka mataku, kau sadarkan aku"},{"time":161.98,"text":"Janganlah bosan"},{"time":166.69,"text":"Kunyanyikan hanya untukmu"},{"time":173.21,"text":"Puja-puji ini karena rindu"},{"time":180,"text":"Air mata terlanjur tumpah"},{"time":186.32,"text":"Membasahi tanah menjadi darah"},{"time":191.43,"text":"• • •"},{"time":193.89,"text":"Dipayungi mega kelabu"},{"time":198.36,"text":"• • •"}]}}}