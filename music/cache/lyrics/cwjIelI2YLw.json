{"status":true,"input":{"id":"cwjIelI2YLw"},"result":{"videoId":"cwjIelI2YLw","title":"Ujung Aspal Pondok Gede","artist":"Iwan Fals","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":30.14,"text":"Di kamar ini, aku dilahirkan"},{"time":39.13,"text":"• • •"},{"time":41.2,"text":"Di balai bambu buah tangan bapakku"},{"time":52.11,"text":"Di rumah ini, aku dibesarkan"},{"time":60.9,"text":"• • •"},{"time":63.29,"text":"Dibelai mesra lentik jari Ibu"},{"time":73.3,"text":"• • •"},{"time":77.01,"text":"Nama dusunku Ujung Aspal Pondok Gede"},{"time":87.92,"text":"Rimbun dan anggun, ramah senyum penghuni dusun"},{"time":98.56,"text":"• • •"},{"time":123.8,"text":"Kambing sembilan, motor tiga bapak punya"},{"time":135.13,"text":"Ladang yang luas habis sudah s'bagai gantinya"},{"time":145.1,"text":"• • •"},{"time":150.05,"text":"Sampai saat tanah moyangku"},{"time":156.8,"text":"• • •"},{"time":158.9,"text":"Tersentuh sebuah rencana"},{"time":162.42,"text":"Dari serakahnya kota"},{"time":167.22,"text":"Terlihat murung wajah pribumi"},{"time":172.85,"text":"Terdengar langkah hewan bernyanyi"},{"time":179.52,"text":"• • •"},{"time":216.22,"text":"Di depan masjid, samping rumah wakil Pak Lurah"},{"time":225.19,"text":"• • •"},{"time":227.46,"text":"Tempat dulu kami bermain, mengisi cerahnya hari"},{"time":238.5,"text":"Namun, sebentar lagi angkuh tembok pabrik berdiri"},{"time":249.49,"text":"Satu per satu sahabat pergi dan takkan pernah kembali"},{"time":260.16,"text":"• • •"},{"time":264.46,"text":"Sampai saat tanah moyangku"},{"time":273.48,"text":"Tersentuh sebuah rencana"},{"time":276.9,"text":"Dari serakahnya kota"},{"time":281.56,"text":"Terlihat murung wajah pribumi"},{"time":287.24,"text":"Terdengar langkah hewan bernyanyi"},{"time":291.14,"text":"• • •"}]}}}