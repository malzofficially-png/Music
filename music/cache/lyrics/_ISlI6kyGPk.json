{"status":true,"input":{"id":"_ISlI6kyGPk"},"result":{"videoId":"_ISlI6kyGPk","title":"Selamat Jalan","artist":"Tipe-X","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":25.32,"text":"Terlalu lama engkau terkenang"},{"time":28.24,"text":"Hancurkan diri, kian jauh tenggelam"},{"time":31.38,"text":"Lelah mencoba 'tuk lepaskan beban"},{"time":34.45,"text":"Kaubeli mimpi, semu tak berarti sendiri"},{"time":43.33,"text":"Tak mampu kau beranjak pergi"},{"time":50.18,"text":"• • •"},{"time":61.23,"text":"Jalan yang panjang, nanar kautatap"},{"time":64.48,"text":"Tak lagi peduli semua yang terjadi"},{"time":67.35,"text":"S'makin dalam larut anganmu melayang"},{"time":70.25,"text":"Mimpimu hadirkan semua penantian"},{"time":73.57,"text":"Alunan apa ajak kau bernyanyi?"},{"time":79.33,"text":"Akhirnya kau pun pergi tak kembali"},{"time":86.71,"text":"Banyak sudah kisah yang tertinggal"},{"time":89.91,"text":"Kaubuat jadi satu kenangan"},{"time":93.04,"text":"Seorang sahabat pergi"},{"time":95.26,"text":"Tanpa tangis, arungi mimpi"},{"time":98.92,"text":"S'lamat jalan, Kawan, cepatlah berlabuh"},{"time":101.92,"text":"Mimpimu kini t'lah kaudapati"},{"time":105.03,"text":"Tak ada lagi seorang pun yang mengganggu"},{"time":109.91,"text":"Kau bernyanyi"},{"time":114.93,"text":"• • •"},{"time":155.77,"text":"Tiap haruku hanya sanggup mengingat"},{"time":158.93,"text":"Jelas bayangmu yang masih melekat"},{"time":161.83,"text":"Dalam kecewa, ku hanya mampu katakan"},{"time":164.83,"text":"Tetaplah tersenyum, kar'na itu jalan yang telah kaupilih"},{"time":173.88,"text":"Terbanglah, oh, terbanglah bersama pelangi"},{"time":181.35,"text":"Banyak sudah kisah yang tertinggal"},{"time":184.59,"text":"Kaubuat jadi satu kenangan"},{"time":187.54,"text":"Seorang sahabat pergi"},{"time":189.69,"text":"Tanpa tangis, arungi mimpi"},{"time":193.47,"text":"S'lamat jalan, Kawan, cepatlah berlabuh"},{"time":196.68,"text":"Mimpimu kini t'lah kaudapati"},{"time":199.48,"text":"