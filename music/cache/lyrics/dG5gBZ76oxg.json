{"status":true,"input":{"id":"dG5gBZ76oxg"},"result":{"videoId":"dG5gBZ76oxg","title":"Mengusung Rindu","artist":"Spin","album":"","source":"lyrics1","lyrics":{"type":"synced","lines":[{"time":22.25,"text":"Dalam hati ini ada nama mu"},{"time":29.86,"text":"Nama seorang insan yang aku rindu"},{"time":36.92,"text":"Dalam diri ini ada sayang mu"},{"time":43.95,"text":"Sayangnya diri mu tidak mengerti"},{"time":51.03,"text":"Dalam senyuman ini ada tangisan"},{"time":57.42,"text":"Tangisan seorang insan terluka"},{"time":64.64,"text":"Dalam jiwa ini ada pilunya"},{"time":71.9,"text":"Pilu yang membuat aku menangis"},{"time":79.5,"text":"Oh hibanya..."},{"time":88.31,"text":"Sayu hati... sayu sekali"},{"time":95.72,"text":"Melihat engkau berpimpin tangan"},{"time":99.73,"text":"Dengan sidia"},{"time":102.69,"text":"Sakit hati... sakit sekali"},{"time":109.98,"text":"Pabila cinta yang aku beri tak dihargai"},{"time":117.37,"text":"Sungguh terhina letih tidak bermaya"},{"time":130.65,"text":"Rasa terkilan bunga yang ku puja"},{"time":139.7,"text":"Kini mekar harum di jambangan orang"},{"time":145.43,"text":"Kau yang ku sayang"},{"time":152.44,"text":"Aku yang gundah"},{"time":158.96,"text":"Kalau tahu sakit begini"},{"time":162.79,"text":"Tidak aku bermain cinta"},{"time":166.18,"text":"Kalau tahu siksa begini"},{"time":169.7,"text":"Tidak aku menyanyangi mu"},{"time":173.39,"text":"Pilu resah di hati ini"},{"time":176.66,"text":"Mengusung rindu..."},{"time":179.34,"text":"• • •"}]}}}