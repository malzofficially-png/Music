{"status":true,"input":{"id":"6Z9ZHKgCVXE"},"result":{"videoId":"6Z9ZHKgCVXE","title":"Sisa Rindu","artist":"Tony Q Rastafara","album":"","source":"lyrics1","lyrics":{"type":"plain","lines":[{"time":-1,"text":"Rintik hujan mengetuk jendela,","translation":""},{"time":-1,"text":"Membawa bayangmu di dalam kepala.","translation":""},{"time":-1,"text":"Ada sisa rindu yang tak terucap,","translation":""},{"time":-1,"text":"Tersimpan dalam hati, tak pernah lenyap.","translation":""},{"time":-1,"text":"Sisa rindu di hujan, mengalir perlahan,","translation":""},{"time":-1,"text":"Membawa namamu di setiap tetesan.","translation":""},{"time":-1,"text":"Meski waktu berlalu, kenangan tetap tinggal,","translation":""},{"time":-1,"text":"Di bawah langit kelabu, aku masih berharap.","translation":""},{"time":-1,"text":"Langkah kecilku menyusuri jalan,","translation":""},{"time":-1,"text":"Di tiap genangan, kulihat bayangan.","translation":""},{"time":-1,"text":"Cinta yang hilang tak pernah usai,","translation":""},{"time":-1,"text":"Hujan ini saksinya hingga kini.","translation":""},{"time":-1,"text":"Sisa rindu di hujan, mengalir perlahan,","translation":""},{"time":-1,"text":"Membawa namamu di setiap tetesan.","translation":""},{"time":-1,"text":"Meski waktu berlalu, kenangan tetap tinggal,","translation":""},{"time":-1,"text":"Di bawah langit kelabu, aku masih berharap.","translation":""},{"time":-1,"text":"Rintik hujan menghapus jejakmu,","translation":""},{"time":-1,"text":"Tapi tak mampu hapus rinduku.","translation":""}]}}}